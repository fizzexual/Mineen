{
  "name": "mineen-panel",
  "version": "2.0.0",
  "description": "Advanced self-hosted Minecraft server control panel (PaperMC)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:web": "vite",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "keywords": [
    "minecraft",
    "paper",
    "panel",
    "server",
    "control-panel"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "unzipper": "^0.12.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.6",
    "svelte": "^5.19.0",
    "jsdom": "^26.0.0",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
